{
  "name": "dsh-wallpaper",
  "version": "0.1.1",
  "description": "为 DSH Web GUI 增加壁纸：本地图片 / 渐变预设、模糊、遮罩浓度与玻璃面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "author": "caomuyes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caomuyes/dsh-wallpaper-only.git"
  },
  "homepage": "https://github.com/caomuyes/dsh-wallpaper-only#readme",
  "bugs": {
    "url": "https://github.com/caomuyes/dsh-wallpaper-only/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "theme"
  ]
}
